        "!pip install yake\n",
        "import yake\n",
        "text = \"Artificial Intelligence enables machines to learn from data.\"\n",
        "kw = yake.KeywordExtractor()\n",
        "keywords = kw.extract_keywords(text)\n",
        "for keyword, score in keywords:\n",
        "    print(f\"{keyword:<35} : {score:.6f}\")"
